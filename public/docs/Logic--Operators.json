{"id": "Logic/Operators", "en": "<h1 id=\"operators\">Operators</h1>\n<h2 id=\"introduction\">Introduction</h2>\n<p>Operators in C++ are symbols that let you perform operations on variables and values. They include arithmetic, logical, comparison, assignment, and bitwise operators. C++ also supports increment/decrement, conditional expressions, and compound assignment. These form the core of most logic and math in any C++ program, including robotics control with VEXcode V5.</p>\n<h3 id=\"arithmetic\">Arithmetic</h3>\n<table>\n<thead>\n<tr>\n<th>Name</th>\n<th>Symbol</th>\n<th>Operator</th>\n<th>Example</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Addition</td>\n<td><code>+</code></td>\n<td><code>a + b</code></td>\n<td><code>5 + 3   // 8</code></td>\n</tr>\n<tr>\n<td>Subtraction</td>\n<td><code>-</code></td>\n<td><code>a - b</code></td>\n<td><code>10 - 3  // 7</code></td>\n</tr>\n<tr>\n<td>Multiplication</td>\n<td><code>*</code></td>\n<td><code>a * b</code></td>\n<td><code>5 * 3   // 15</code></td>\n</tr>\n<tr>\n<td>Division</td>\n<td><code>/</code></td>\n<td><code>a / b</code></td>\n<td><code>10 / 4  // 2 (integer division)</code></td>\n</tr>\n<tr>\n<td>Modulo</td>\n<td><code>%</code></td>\n<td><code>a % b</code></td>\n<td><code>10 % 4  // 2</code></td>\n</tr>\n<tr>\n<td>Negation</td>\n<td><code>-</code></td>\n<td><code>-a</code></td>\n<td><code>-5      // -5</code></td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"augmented-arithmetic\">Augmented Arithmetic</h3>\n<table>\n<thead>\n<tr>\n<th>Name</th>\n<th>Symbol</th>\n<th>Operator</th>\n<th>Example</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Addition</td>\n<td><code>+=</code></td>\n<td><code>a += b</code></td>\n<td><code>int a = 5;</code><br/><code> int b = 3;</code><br/><code> a += b; // a = 8</code></td>\n</tr>\n<tr>\n<td>Subtraction</td>\n<td><code>-=</code></td>\n<td><code>a -= b</code></td>\n<td><code>int a = 10;</code><br/><code> int b = 4;</code><br/><code> a -= b; // a = 6</code></td>\n</tr>\n<tr>\n<td>Multiplication</td>\n<td><code>*=</code></td>\n<td><code>a *= b</code></td>\n<td><code>int a = 2;</code><br/><code> int b = 3;</code><br/><code> a *= b; // a = 6</code></td>\n</tr>\n<tr>\n<td>Division</td>\n<td><code>/=</code></td>\n<td><code>a /= b</code></td>\n<td><code>int a = 10;</code><br/><code> int b = 4;</code><br/><code> a /= b; // a = 2</code></td>\n</tr>\n<tr>\n<td>Modulo</td>\n<td><code>%=</code></td>\n<td><code>a %= b</code></td>\n<td><code>int a = 10;</code><br/><code> int b = 3;</code><br/><code> a %= b; // a = 1</code></td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"comparison\">Comparison</h3>\n<table>\n<thead>\n<tr>\n<th>Name</th>\n<th>Symbol</th>\n<th>Operator</th>\n<th>Example</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Equality</td>\n<td><code>==</code></td>\n<td><code>a == b</code></td>\n<td><code>5 == 5    // true</code></td>\n</tr>\n<tr>\n<td>Inequality</td>\n<td><code>!=</code></td>\n<td><code>a != b</code></td>\n<td><code>5 != 10   // true</code></td>\n</tr>\n<tr>\n<td>Greater Than</td>\n<td><code>&gt;</code></td>\n<td><code>a &gt; b</code></td>\n<td><code>10 &gt; 5    // true</code></td>\n</tr>\n<tr>\n<td>Less Than</td>\n<td><code>&lt;</code></td>\n<td><code>a &lt; b</code></td>\n<td><code>5 &lt; 10    // true</code></td>\n</tr>\n<tr>\n<td>Greater Than or Equal</td>\n<td><code>&gt;=</code></td>\n<td><code>a &gt;= b</code></td>\n<td><code>10 &gt;= 10  // true</code></td>\n</tr>\n<tr>\n<td>Less Than or Equal</td>\n<td><code>&lt;=</code></td>\n<td><code>a &lt;= b</code></td>\n<td><code>5 &lt;= 5    // true</code></td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"logical\">Logical</h3>\n<table>\n<thead>\n<tr>\n<th>Name</th>\n<th>Symbol</th>\n<th>Operator</th>\n<th>Example</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Logical AND</td>\n<td><code>&amp;&amp;</code></td>\n<td><code>a &amp;&amp; b</code></td>\n<td><code>true &amp;&amp; false   // false</code></td>\n</tr>\n<tr>\n<td>Logical OR</td>\n<td><code>||</code></td>\n<td><code>a || b</code></td>\n<td><code>false || true  // true</code></td>\n</tr>\n<tr>\n<td>Logical NOT</td>\n<td><code>!</code></td>\n<td><code>!a</code></td>\n<td><code>!true           // false</code></td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"assignment\">Assignment</h3>\n<table>\n<thead>\n<tr>\n<th>Name</th>\n<th>Symbol</th>\n<th>Operator</th>\n<th>Example</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Assignment</td>\n<td><code>=</code></td>\n<td><code>a = b</code></td>\n<td><code>int a = 10;</code></td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"bitwise\">Bitwise</h3>\n<table>\n<thead>\n<tr>\n<th>Name</th>\n<th>Symbol</th>\n<th>Operator</th>\n<th>Example</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Bitwise AND</td>\n<td><code>&amp;</code></td>\n<td><code>a &amp; b</code></td>\n<td><code>6 &amp; 3   // 2 (0b110 &amp; 0b011)</code></td>\n</tr>\n<tr>\n<td>Bitwise OR</td>\n<td><code>|</code></td>\n<td><code>a | b</code></td>\n<td><code>6 | 3   // 7 (0b110 | 0b011)</code></td>\n</tr>\n<tr>\n<td>Bitwise XOR</td>\n<td><code>^</code></td>\n<td><code>a ^ b</code></td>\n<td><code>6 ^ 3   // 5 (0b110 ^ 0b011)</code></td>\n</tr>\n<tr>\n<td>Bitwise NOT</td>\n<td><code>~</code></td>\n<td><code>~a</code></td>\n<td><code>~5      // -6</code></td>\n</tr>\n<tr>\n<td>Left Shift</td>\n<td><code>&lt;&lt;</code></td>\n<td><code>a &lt;&lt; b</code></td>\n<td><code>2 &lt;&lt; 3  // 16</code></td>\n</tr>\n<tr>\n<td>Right Shift</td>\n<td><code>&gt;&gt;</code></td>\n<td><code>a &gt;&gt; b</code></td>\n<td><code>16 &gt;&gt; 2 // 4</code></td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"augmented-bitwise\">Augmented Bitwise</h3>\n<table>\n<thead>\n<tr>\n<th>Name</th>\n<th>Symbol</th>\n<th>Operator</th>\n<th>Example</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Bitwise AND</td>\n<td><code>&amp;=</code></td>\n<td><code>a &amp;= b</code></td>\n<td><code>int a = 6;</code><br/><code>a &amp;= 3;  // a = 2</code></td>\n</tr>\n<tr>\n<td>Bitwise OR</td>\n<td><code>|=</code></td>\n<td><code>a |= b</code></td>\n<td><code>int a = 6;</code><br/><code>a |= 3; // a = 7</code></td>\n</tr>\n<tr>\n<td>Bitwise XOR</td>\n<td><code>^=</code></td>\n<td><code>a ^= b</code></td>\n<td><code>int a = 6;</code><br/><code>a ^= 3;  // a = 5</code></td>\n</tr>\n<tr>\n<td>Left Shift</td>\n<td><code>&lt;&lt;=</code></td>\n<td><code>a &lt;&lt;= b</code></td>\n<td><code>int a = 5;</code><br/><code>a &lt;&lt;= 2; // a = 20</code></td>\n</tr>\n<tr>\n<td>Right Shift</td>\n<td><code>&gt;&gt;=</code></td>\n<td><code>a &gt;&gt;= b</code></td>\n<td><code>int a = 20;</code><br/><code>a &gt;&gt;= 2; // a = 5</code></td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"ternary-conditional\">Ternary (Conditional)</h3>\n<table>\n<thead>\n<tr>\n<th>Name</th>\n<th>Syntax</th>\n<th>Example</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Conditional Operator</td>\n<td><code>condition ? expr1 : expr2</code></td>\n<td><code>int a = 6;</code><br/><code>int b = 3;</code><br/><code>int max = (a &gt; b) ? a : b; // max = 6</code></td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"increment-decrement\">Increment / Decrement</h3>\n<table>\n<thead>\n<tr>\n<th>Name</th>\n<th>Symbol</th>\n<th>Operator</th>\n<th>Example</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>Pre-Increment</td>\n<td><code>++</code></td>\n<td><code>++a</code></td>\n<td><code>int a = 5;</code><br/><code>int b = ++a;</code><br/><code>// a = 6, b = 6</code></td>\n</tr>\n<tr>\n<td>Post-Increment</td>\n<td><code>++</code></td>\n<td><code>a++</code></td>\n<td><code>int a = 5;</code><br/><code>int b = a++;</code><br/><code>// a = 6, b = 5</code></td>\n</tr>\n<tr>\n<td>Pre-Decrement</td>\n<td><code>--</code></td>\n<td><code>--a</code></td>\n<td><code>int a = 5;</code><br/><code>int b = --a;</code><br/><code>// a = 4, b = 4</code></td>\n</tr>\n<tr>\n<td>Post-Decrement</td>\n<td><code>--</code></td>\n<td><code>a--</code></td>\n<td><code>int a = 5;</code><br/><code>int b = a--;</code><br/><code>// a = 4, b = 5</code></td>\n</tr>\n</tbody>\n</table>\n", "zh": "<h1 id=\"operators\">运算符</h1>\n<h2 id=\"introduction\">概述</h2>\n<p>C++ 中的运算符是允许您对变量和值执行运算的符号。它们包括算术运算符、逻辑运算符、比较运算符、赋值运算符和位运算符。 C++ 还支持递增/递减、条件表达式和复合赋值。它们构成了任何 C++ 程序中大多数逻辑和数学的核心，包括使用 VEXcode V5 进行机器人控制。</p>\n<h3 id=\"arithmetic\">算术</h3>\n<table>\n<thead>\n<tr>\n<th>名称</th>\n<th>符号</th>\n<th>操作员</th>\n<th>示例</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>加法</td>\n<td><code>+</code></td>\n<td><code>a + b</code></td>\n<td><code>5 + 3   // 8</code></td>\n</tr>\n<tr>\n<td>减法</td>\n<td><code>-</code></td>\n<td><code>a - b</code></td>\n<td><code>10 - 3  // 7</code></td>\n</tr>\n<tr>\n<td>乘法</td>\n<td><code>*</code></td>\n<td><code>a * b</code></td>\n<td><code>5 * 3   // 15</code></td>\n</tr>\n<tr>\n<td>师</td>\n<td><code>/</code></td>\n<td><code>a / b</code></td>\n<td><code>10 / 4  // 2 (integer division)</code></td>\n</tr>\n<tr>\n<td>模数</td>\n<td><code>%</code></td>\n<td><code>a % b</code></td>\n<td><code>10 % 4  // 2</code></td>\n</tr>\n<tr>\n<td>否定</td>\n<td><code>-</code></td>\n<td><code>-a</code></td>\n<td><code>-5      // -5</code></td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"augmented-arithmetic\">增强算术</h3>\n<table>\n<thead>\n<tr>\n<th>名称</th>\n<th>符号</th>\n<th>操作员</th>\n<th>示例</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>加法</td>\n<td><code>+=</code></td>\n<td><code>a += b</code></td>\n<td><code>int a = 5;</code><br/><code> int b = 3;</code><br/><code> a += b; // a = 8</code></td>\n</tr>\n<tr>\n<td>减法</td>\n<td><code>-=</code></td>\n<td><code>a -= b</code></td>\n<td><code>int a = 10;</code><br/><code> int b = 4;</code><br/><code> a -= b; // a = 6</code></td>\n</tr>\n<tr>\n<td>乘法</td>\n<td><code>*=</code></td>\n<td><code>a *= b</code></td>\n<td><code>int a = 2;</code><br/><code> int b = 3;</code><br/><code> a *= b; // a = 6</code></td>\n</tr>\n<tr>\n<td>师</td>\n<td><code>/=</code></td>\n<td><code>a /= b</code></td>\n<td><code>int a = 10;</code><br/><code> int b = 4;</code><br/><code> a /= b; // a = 2</code></td>\n</tr>\n<tr>\n<td>模数</td>\n<td><code>%=</code></td>\n<td><code>a %= b</code></td>\n<td><code>int a = 10;</code><br/><code> int b = 3;</code><br/><code> a %= b; // a = 1</code></td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"comparison\">比较</h3>\n<table>\n<thead>\n<tr>\n<th>名称</th>\n<th>符号</th>\n<th>操作员</th>\n<th>示例</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>平等</td>\n<td><code>==</code></td>\n<td><code>a == b</code></td>\n<td><code>5 == 5    // true</code></td>\n</tr>\n<tr>\n<td>不平等</td>\n<td><code>!=</code></td>\n<td><code>a != b</code></td>\n<td><code>5 != 10   // true</code></td>\n</tr>\n<tr>\n<td>大于</td>\n<td><code>&gt;</code></td>\n<td><code>a &gt; b</code></td>\n<td><code>10 &gt; 5    // true</code></td>\n</tr>\n<tr>\n<td>小于</td>\n<td><code>&lt;</code></td>\n<td><code>a &lt; b</code></td>\n<td><code>5 &lt; 10    // true</code></td>\n</tr>\n<tr>\n<td>大于或等于</td>\n<td><code>&gt;=</code></td>\n<td><code>a &gt;= b</code></td>\n<td><code>10 &gt;= 10  // true</code></td>\n</tr>\n<tr>\n<td>小于或等于</td>\n<td><code>&lt;=</code></td>\n<td><code>a &lt;= b</code></td>\n<td><code>5 &lt;= 5    // true</code></td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"logical\">逻辑性</h3>\n<table>\n<thead>\n<tr>\n<th>名称</th>\n<th>符号</th>\n<th>操作员</th>\n<th>示例</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>逻辑与</td>\n<td><code>&amp;&amp;</code></td>\n<td><code>a &amp;&amp; b</code></td>\n<td><code>true &amp;&amp; false   // false</code></td>\n</tr>\n<tr>\n<td>逻辑或</td>\n<td><code>||</code></td>\n<td><code>a || b</code></td>\n<td><code>false || true  // true</code></td>\n</tr>\n<tr>\n<td>逻辑非</td>\n<td><code>!</code></td>\n<td><code>!a</code></td>\n<td><code>!true           // false</code></td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"assignment\">作业</h3>\n<table>\n<thead>\n<tr>\n<th>名称</th>\n<th>符号</th>\n<th>操作员</th>\n<th>示例</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>作业</td>\n<td><code>=</code></td>\n<td><code>a = b</code></td>\n<td><code>int a = 10;</code></td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"bitwise\">按位</h3>\n<table>\n<thead>\n<tr>\n<th>名称</th>\n<th>符号</th>\n<th>操作员</th>\n<th>示例</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>按位与</td>\n<td><code>&amp;</code></td>\n<td><code>a &amp; b</code></td>\n<td><code>6 &amp; 3   // 2 (0b110 &amp; 0b011)</code></td>\n</tr>\n<tr>\n<td>按位或</td>\n<td><code>|</code></td>\n<td><code>a | b</code></td>\n<td><code>6 | 3   // 7 (0b110 | 0b011)</code></td>\n</tr>\n<tr>\n<td>按位异或</td>\n<td><code>^</code></td>\n<td><code>a ^ b</code></td>\n<td><code>6 ^ 3   // 5 (0b110 ^ 0b011)</code></td>\n</tr>\n<tr>\n<td>按位非</td>\n<td><code>~</code></td>\n<td><code>~a</code></td>\n<td><code>~5      // -6</code></td>\n</tr>\n<tr>\n<td>左移</td>\n<td><code>&lt;&lt;</code></td>\n<td><code>a &lt;&lt; b</code></td>\n<td><code>2 &lt;&lt; 3  // 16</code></td>\n</tr>\n<tr>\n<td>右移</td>\n<td><code>&gt;&gt;</code></td>\n<td><code>a &gt;&gt; b</code></td>\n<td><code>16 &gt;&gt; 2 // 4</code></td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"augmented-bitwise\">按位增强</h3>\n<table>\n<thead>\n<tr>\n<th>名称</th>\n<th>符号</th>\n<th>操作员</th>\n<th>示例</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>按位与</td>\n<td><code>&amp;=</code></td>\n<td><code>a &amp;= b</code></td>\n<td><code>int a = 6;</code><br/><code>a &amp;= 3;  // a = 2</code></td>\n</tr>\n<tr>\n<td>按位或</td>\n<td><code>|=</code></td>\n<td><code>a |= b</code></td>\n<td><code>int a = 6;</code><br/><code>a |= 3; // a = 7</code></td>\n</tr>\n<tr>\n<td>按位异或</td>\n<td><code>^=</code></td>\n<td><code>a ^= b</code></td>\n<td><code>int a = 6;</code><br/><code>a ^= 3;  // a = 5</code></td>\n</tr>\n<tr>\n<td>左移</td>\n<td><code>&lt;&lt;=</code></td>\n<td><code>a &lt;&lt;= b</code></td>\n<td><code>int a = 5;</code><br/><code>a &lt;&lt;= 2; // a = 20</code></td>\n</tr>\n<tr>\n<td>右移</td>\n<td><code>&gt;&gt;=</code></td>\n<td><code>a &gt;&gt;= b</code></td>\n<td><code>int a = 20;</code><br/><code>a &gt;&gt;= 2; // a = 5</code></td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"ternary-conditional\">三元（有条件）</h3>\n<table>\n<thead>\n<tr>\n<th>名称</th>\n<th>语法</th>\n<th>示例</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>条件运算符</td>\n<td><code>condition ? expr1 : expr2</code></td>\n<td><code>int a = 6;</code><br/><code>int b = 3;</code><br/><code>int max = (a &gt; b) ? a : b; // max = 6</code></td>\n</tr>\n</tbody>\n</table>\n<h3 id=\"increment-decrement\">增加/减少</h3>\n<table>\n<thead>\n<tr>\n<th>名称</th>\n<th>符号</th>\n<th>操作员</th>\n<th>示例</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>预增量</td>\n<td><code>++</code></td>\n<td><code>++a</code></td>\n<td><code>int a = 5;</code><br/><code>int b = ++a;</code><br/><code>// a = 6, b = 6</code></td>\n</tr>\n<tr>\n<td>后增量</td>\n<td><code>++</code></td>\n<td><code>a++</code></td>\n<td><code>int a = 5;</code><br/><code>int b = a++;</code><br/><code>// a = 6, b = 5</code></td>\n</tr>\n<tr>\n<td>预减</td>\n<td><code>--</code></td>\n<td><code>--a</code></td>\n<td><code>int a = 5;</code><br/><code>int b = --a;</code><br/><code>// a = 4, b = 4</code></td>\n</tr>\n<tr>\n<td>后递减</td>\n<td><code>--</code></td>\n<td><code>a--</code></td>\n<td><code>int a = 5;</code><br/><code>int b = a--;</code><br/><code>// a = 4, b = 5</code></td>\n</tr>\n</tbody>\n</table>\n", "headings": [{"id": "operators", "en": "Operators", "level": 1, "zh": "运算符"}, {"id": "introduction", "en": "Introduction", "level": 2, "zh": "概述"}, {"id": "arithmetic", "en": "Arithmetic", "level": 3, "zh": "算术"}, {"id": "augmented-arithmetic", "en": "Augmented Arithmetic", "level": 3, "zh": "增强算术"}, {"id": "comparison", "en": "Comparison", "level": 3, "zh": "比较"}, {"id": "logical", "en": "Logical", "level": 3, "zh": "逻辑性"}, {"id": "assignment", "en": "Assignment", "level": 3, "zh": "作业"}, {"id": "bitwise", "en": "Bitwise", "level": 3, "zh": "按位"}, {"id": "augmented-bitwise", "en": "Augmented Bitwise", "level": 3, "zh": "按位增强"}, {"id": "ternary-conditional", "en": "Ternary (Conditional)", "level": 3, "zh": "三元（有条件）"}, {"id": "increment-decrement", "en": "Increment / Decrement", "level": 3, "zh": "增加/减少"}]}